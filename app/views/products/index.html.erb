<div id="grid">
  <div id="left">
    <h1>Filters</h1>

    <br/>

    <%= form_with html: { class: "form-container" }, method: :get, local: true do |form| %>
      <div class="container">
        <%= form.text_field :search, class: "input", value: params[:search] %>
        <%= form.label :search, class: "label" %>
      </div>

      <br/> <br/>

      <div class="container">
        <%= form.number_field :max_price, class: "input", value: params[:max_price] %>
        <%= form.label :max_price, class: "label" %>
      </div>

      <br/> <br/>


      <div class="container">
        <%= form.number_field :weight, class: "input", value: params[:weight] %>
        <%= form.label :weight, class: "label" %>
      </div>

      <br/> <br/>

      <div class="container">
        <%= form.number_field :size, class: "input", value: params[:size] %>
        <%= form.label :size, class: "label" %>
      </div>

      <br/>

      <div class="container">
        <% lists = {
          color: Array.new(1000) { Faker::Color.color_name }.uniq.sort,
          material: Array.new(1000) { Faker::Construction.material }.uniq.sort,
          company: Array.new(1000) { Faker::Company.name }.uniq.sort,
          country: Array.new(1000) { Faker::Address.country }.uniq.sort,
          ingredient: Array.new(1000) { Faker::Food.ingredient }.uniq.sort
        } %>

        <% lists.each do |key, items| %>
          <div class="checkbox_wrapper" id="<%= "#{key}_wrapper" %>">
            <div class="checkbox_title">
              <button type="button"><%= key.to_s.capitalize %> ▾</button>
            </div>
            <div class="checkboxes">
              <% items.each do |item| %>
                <label>
                  <%= check_box_tag "model[#{key}][]", item, Array(params[key]).include?(item), class: "input", id: "#{key}_#{item.parameterize}" %>
                  <span class="custom-checkbox"></span>
                  <%= item %>
                </label>
                <br/>
              <% end %>
            </div>
          </div>
          <br/> <br/>
        <% end %>
      </div>

      <br/> <br/>

      <div class="container">
        <%= form.number_field :brightness, class: "input", value: params[:brightness] %>
        <%= form.label :brightness, class: "label" %>
      </div>

      <br/>

      <label>
        <%= check_box_tag :waterproof, '1', params[:waterproof] == '1', class: "input" %>
        <span class="custom-checkbox"></span>
        waterproof
      </label>

      <br/> <br/>

      <div>
        <%= form.submit :Search %>
      </div>
    <% end %>
  </div>

  <div id="right">
    <h1>Products</h1>

    <div id="products" style="display: flex; flex-wrap: wrap; gap: 40px;">
      <% @search_results.each do |record| %>
        <div>
          <% if record.featured_image.attached? %>
            <h2><%= record.name %> <%= number_to_currency(record.price_in_cents.to_f / 100, locale: :fr) %></h2>
            <%= link_to record do %>
              <%= image_tag record.featured_image, alt: record.name %>
            <% end %>
          <% else %>
            <%= link_to "#{record.name} - #{number_to_currency(record.price_in_cents.to_f / 100, locale: :fr)}", record %>
          <% end %>
          <br/> <br/>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
    document.querySelectorAll('.checkbox_title button').forEach(btn => {
        btn.addEventListener('click', () => {
            const parent = btn.closest('.checkbox_wrapper');
            const checkboxes = parent.querySelectorAll('.checkboxes');
            const current = parseInt(getComputedStyle(parent).height, 10);
            const collapsed = current > 52;
            parent.style.height = (collapsed ? 52 : 320) + 'px';
            checkboxes.forEach(cb => {
                cb.style.display = (collapsed ? 'none' : 'block');
            });
        });
    });

</script>