<h1><%= @product.name %></h1>

<%= image_tag @product.featured_image if @product.featured_image.attached? %>

<br/> <br/>


<%= form_with(model: [@product, @product.comments.build], html: { class: "form-container" }) do |form| %>

  <div class="container">
    <%= form.text_area :content, class: "input" %>
    <%= form.label :content, class: "label" %>
  </div>

  <br/>

  <div>
    <%= form.submit "Add a comment" %>
  </div>

<% end %>

<br/> <br/>

<p><%= @product.description %></p>

<br/> <br/>

<% @product.comments.includes(:user).each do |comment| %>
  <p><%= comment.user&.first_name || "Deleted user" %>: <%= comment.content %></p>
<% end %>

<br/> <br/>

<%= link_to "Back", products_path %>
